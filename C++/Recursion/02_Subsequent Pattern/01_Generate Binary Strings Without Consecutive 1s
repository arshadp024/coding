Q.Given a positive integer n, count all possible distinct binary strings of length n such that there are no consecutive 1’s.
-----------------------------------------------Optimal without DP----------------------------------------
class Solution {
  public:
    int countStrings(int n) {
        int v=fibbo(n+2);
        return v;
    }
    int fibbo(int n){
        int sum;
        if(n==0){
            return 0;
        }
        if(n==1){
            return 1;
        }
        sum=fibbo(n-1)+fibbo(n-2);
        return sum;
    }
};
